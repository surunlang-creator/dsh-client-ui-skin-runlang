{
  "name": "dsh-client-ui-skin-runlang",
  "description": "Runlang: courtyard-video skin for the DSH Web UI - smoked glass, wallpaper library (uploads, GLSL, Wallpaper Engine), music player, nine-effect reasoning rail with the full tier list, twelve companions including Baili, and an uploadable opening animation.",
  "version": "1.8.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./skin.json": "./skin.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "author": "surunlang-creator",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/surunlang-creator/dsh-client-ui-skin-runlang.git"
  },
  "homepage": "https://github.com/surunlang-creator/dsh-client-ui-skin-runlang#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-skin",
    "deepseek-harness",
    "theme",
    "skin",
    "runlang",
    "wallpaper",
    "music-player"
  ],
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-0 <0.2.2-0 || >=0.2.2-0 <0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-api-remotes": ">=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-0 <0.2.2-0 || >=0.2.2-0 <0.3.0-0",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.0-rc.1 <0.2.1-0 || >=0.2.1-0 <0.2.2-0 || >=0.2.2-0 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-api-remotes": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-session-controller": {
      "optional": true
    }
  },
  "files": [
    "lib",
    "docs",
    "assets",
    "vendor",
    "presets",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "skin.json",
    "LICENSE",
    "README.md",
    "!assets/qinglan-loop.mp4",
    "!docs/demo.gif"
  ]
}
